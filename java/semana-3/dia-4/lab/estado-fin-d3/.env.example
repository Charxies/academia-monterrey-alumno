# .env.example — plantilla de variables (SÍ se commitea; documenta QUÉ existe, sin valores reales).
# Copiar a .env y rellenar:   cp .env.example .env
# El .env real NUNCA se commitea (.gitignore lo cubre).
#
# Reglas del formato (dolor #8): SIN comillas, SIN espacios alrededor de '=', line endings LF.
#   JWT_SECRET="abc"  -> las comillas entran AL VALOR y el token firma con "abc" literal (401 misteriosos).
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow
POSTGRES_DB=taskflow
JWT_SECRET=reemplaza-con-el-secret-de-64-chars-de-tu-application-yml
