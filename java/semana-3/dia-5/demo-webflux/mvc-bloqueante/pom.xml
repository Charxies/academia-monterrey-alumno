<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Mismo parent y version que taskflow-api: el gemelo bloqueante es Spring MVC (Tomcat). -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.3</version>
        <relativePath/>
    </parent>

    <groupId>com.taskflow.demo</groupId>
    <artifactId>mvc-bloqueante</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>mvc-bloqueante</name>
    <description>Demo AM-1 (S3D5): GET /tareas bloqueante (Tomcat, pool capado a 10) para VERLO en numeros.</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- SOLO web: Tomcat embebido + Spring MVC. El thread atiende y se BLOQUEA esperando. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
