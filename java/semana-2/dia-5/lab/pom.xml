<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- spring-boot-starter-parent: el "padre" que GESTIONA las versiones de todas las dependencias
         de Spring (por eso abajo casi ninguna lleva <version>) y la config de plugins. Línea 3.5.x
         FIJADA para toda la S2. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.3</version>
        <relativePath/> <!-- lo busca en el repositorio, no en un pom padre local -->
    </parent>

    <groupId>com.taskflow</groupId>
    <artifactId>taskflow-api</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>taskflow-api</name>
    <description>TaskFlow API - S2D5: seguridad con Spring Security + JWT (login stateless, roles, regla de owner)</description>

    <properties>
        <!-- Java 21: seleccionado explícito en el wizard (no el default del sitio). -->
        <java.version>21</java.version>
        <!-- Versión CANÓNICA de jjwt fijada para todo el día (los 3 artefactos van a la par). -->
        <jjwt.version>0.12.6</jjwt.version>
    </properties>

    <dependencies>
        <!-- spring-boot-starter-web: Tomcat embebido + Spring MVC (@RestController/@GetMapping) +
             Jackson (objeto <-> JSON). Viene desde D2. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- spring-boot-starter-validation: Hibernate Validator (jakarta.validation). Viene de D3. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- spring-boot-starter-data-jpa: JPA + Hibernate + Spring Data JPA. Viene de D4. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- spring-boot-starter-security: AGREGADA HOY (S2D5). Al entrar al classpath auto-configura
             una SecurityFilterChain por defecto que BLOQUEA TODO (401 universal) y un usuario 'user'
             con password generado en consola. El trabajo del día es sustituir CADA default: usuario en
             memoria -> tabla users; Basic -> JWT. Quien trabaja en su repo la añade a mano en MP-1. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- h2: la base de datos del día a día. scope runtime porque el código nunca importa org.h2.*
             (el driver se carga solo por ServiceLoader al abrir jdbc:h2:...). Runtime = ARCHIVO; los
             tests = MEMORIA (perfil test). Viene de D4. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- jjwt (Java JWT) EN 3 ARTEFACTOS, TODOS 0.12.6 (punto de dolor 2):
               - jjwt-api      (compile): la API pública que SÍ tocamos (Jwts.builder()/parser()).
               - jjwt-impl     (runtime): la implementación; sin ella compila pero truena al generar el
                                primer token ("Unable to discover services..."/ClassNotFoundException).
               - jjwt-jackson  (runtime): serializa/deserializa el JSON de los claims con Jackson.
             Mezclar 0.11.x con 0.12.x rompe la API del parser (parserBuilder() vs parser()): por eso
             los tutoriales viejos no compilan aquí. -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- STRETCH (swap a PostgreSQL): DESCOMENTAR para el anexo guiado de D4/S3. Comentada por
             default para que el día principal (H2 archivo) no arrastre un driver que no usa.
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        -->

        <!-- springdoc-openapi: Swagger UI + /v3/api-docs. Versión FIJADA a 2.8.9 (compatible con
             Boot 3.5.x). Viene de D3. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.9</version>
        </dependency>

        <!-- spring-boot-starter-test: JUnit 5 + AssertJ + Mockito + spring-test (MockMvc). scope test. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- spring-security-test: helpers de seguridad para tests (@WithMockUser, SecurityMockMvc...).
             El material usa el patrón CANÓNICO "token real en el setup" (login real vía MockMvc), no
             @WithMockUser; esta dependencia está SOLO por si alguna pareja explora esa alternativa. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- spring-boot-maven-plugin: 'mvn spring-boot:run' arranca la app; empaqueta el jar
                 ejecutable. Hereda su config del parent. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
